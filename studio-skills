<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Studio Skills — Hidden Room Studios</title>
<meta name="description" content="One-on-one recording, mixing, and production instruction with Patrick Hume at Hidden Room Studios. Bring your own project. 90-minute session — $90.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#F5F1E7;
    --cream-2:#EDE6D6;
    --ink:#2B2A25;
    --forest:#2F4A3C;
    --forest-deep:#1E3229;
    --gold:#B08A3E;
    --line:rgba(43,42,37,0.14);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--cream);
    color:var(--ink);
    font-family:'Jost', sans-serif;
    font-weight:400;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{
    font-family:'Playfair Display', serif;
    color:var(--forest-deep);
    margin:0 0 0.5em 0;
    font-weight:600;
    letter-spacing:-0.01em;
  }
  a{color:inherit;}
  .wrap{max-width:760px;margin:0 auto;padding:0 28px;}
  .eyebrow{
    font-size:0.78rem;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:var(--gold);
    font-weight:500;
    margin-bottom:14px;
    display:block;
  }
  section{padding:88px 0;}
  section + section{border-top:1px solid var(--line);}

  /* HERO */
  .hero{
    padding:120px 0 96px;
    text-align:center;
    position:relative;
  }
  .hero h1{
    font-size:clamp(2.4rem, 6vw, 3.6rem);
    line-height:1.05;
  }
  .hero .sub{
    font-family:'Playfair Display', serif;
    font-style:italic;
    font-weight:500;
    font-size:clamp(1.15rem, 2.6vw, 1.45rem);
    color:var(--forest);
    margin:0 auto 22px;
    max-width:520px;
  }
  .hero .desc{
    max-width:480px;
    margin:0 auto 8px;
    font-size:1.02rem;
    color:#4a493f;
  }
  .hero .bold-line{
    max-width:480px;
    margin:18px auto 36px;
    font-weight:500;
    color:var(--ink);
  }
  .price-tag{
    display:inline-flex;
    align-items:baseline;
    gap:10px;
    font-family:'Playfair Display', serif;
    font-size:1.3rem;
    color:var(--forest-deep);
    margin-bottom:30px;
  }
  .price-tag .amount{
    font-size:2rem;
    font-weight:700;
    color:var(--gold);
  }
  .btn{
    display:inline-block;
    background:var(--forest);
    color:var(--cream);
    font-family:'Jost', sans-serif;
    text-decoration:none;
    font-size:0.95rem;
    letter-spacing:0.04em;
    padding:16px 36px;
    border-radius:2px;
    transition:background 0.2s ease, transform 0.2s ease;
    border:1px solid var(--forest);
  }
  .btn:hover{background:var(--forest-deep);transform:translateY(-1px);}
  .btn-ghost{
    background:transparent;
    color:var(--forest-deep);
    border:1px solid var(--forest-deep);
  }
  .btn-ghost:hover{background:var(--forest-deep);color:var(--cream);}
  .cta-row{
    display:flex;
    gap:14px;
    justify-content:center;
    flex-wrap:wrap;
  }

  /* IMAGES */
  
  <img src="images/patrick-hume.png">{
    background:var(--cream-2);
    border:1px dashed var(--gold);
    color:#8a8776;
    font-size:0.85rem;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    overflow:hidden;
  }
  <img src="images/patrick-hume.png">{width:100%;height:100%;object-fit:cover;display:block;}
  .hero-img{
    max-width:640px;
    height:340px;
    margin:0 auto 40px;
    border-radius:2px;
  }
  .about-photo{
    width:160px;
    height:160px;
    border-radius:50%;
    float:left;
    margin:0 24px 12px 0;
  }
  .about-clear{clear:both;}

  /* FORM */
  .inquiry-form{
    max-width:520px;
    margin:36px auto 0;
    text-align:left;
  }
  .form-row{
    display:flex;
    gap:14px;
    margin-bottom:14px;
  }
  .inquiry-form input,
  .inquiry-form select,
  .inquiry-form textarea{
    flex:1;
    width:100%;
    font-family:'Jost', sans-serif;
    font-size:0.95rem;
    color:var(--ink);
    background:var(--cream);
    border:1px solid var(--line);
    border-radius:2px;
    padding:13px 14px;
    outline:none;
  }
  .inquiry-form input:focus,
  .inquiry-form select:focus,
  .inquiry-form textarea:focus{
    border-color:var(--forest);
  }
  .inquiry-form textarea{
    min-height:100px;
    resize:vertical;
    margin-bottom:10px;
    font-family:'Jost', sans-serif;
  }
  .form-note{
    font-size:0.8rem;
    color:#8a8776;
    margin:0 0 18px;
  }
  .btn-submit{
    display:block;
    width:100%;
    background:var(--forest);
    color:var(--cream);
    font-family:'Jost', sans-serif;
    font-size:0.95rem;
    letter-spacing:0.04em;
    padding:16px;
    border:1px solid var(--forest);
    border-radius:2px;
    cursor:pointer;
    transition:background 0.2s ease;
  }
  .btn-submit:hover{background:var(--forest-deep);}
  .divider-or{
    text-align:center;
    color:#8a8776;
    font-size:0.85rem;
    margin:28px 0;
    position:relative;
  }

  /* PROBLEM */
  .problem{background:var(--cream-2);}
  .problem .wrap{text-align:center;}
  .problem h2{font-size:clamp(1.7rem,4vw,2.2rem);max-width:560px;margin-left:auto;margin-right:auto;}
  .problem p{max-width:520px;margin:0 auto 16px;color:#4a493f;}
  .problem strong{color:var(--forest-deep);}

  /* WHAT WE WORK ON */
  .topics h2{font-size:clamp(1.6rem,4vw,2rem);text-align:center;margin-bottom:36px;}
  .topic-grid{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:10px 24px;
    list-style:none;
    padding:0;
    margin:0 0 40px 0;
  }
  .topic-grid li{
    padding:12px 0;
    border-bottom:1px solid var(--line);
    font-size:0.98rem;
    color:#3a392f;
  }
  .note-box{
    background:var(--cream-2);
    border-left:3px solid var(--gold);
    padding:20px 24px;
    font-family:'Playfair Display', serif;
    font-style:italic;
    font-size:1.05rem;
    color:var(--forest-deep);
  }

  /* SESSION FLOW */
  .flow{background:var(--forest-deep);color:var(--cream);}
  .flow h2{color:var(--cream);font-size:clamp(1.6rem,4vw,2rem);text-align:center;margin-bottom:44px;}
  .flow-steps{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:28px;
  }
  .flow-step{text-align:center;}
  .flow-step .num{
    font-family:'Playfair Display', serif;
    font-style:italic;
    color:var(--gold);
    font-size:0.95rem;
    display:block;
    margin-bottom:10px;
  }
  .flow-step .label{
    font-family:'Playfair Display', serif;
    font-weight:600;
    font-size:1.15rem;
    color:var(--cream);
  }

  /* WHO IT'S FOR */
  .who .wrap{max-width:620px;}
  .who blockquote{
    margin:0 0 24px 0;
    padding:0;
    font-size:1.08rem;
    color:#3a392f;
  }
  .who .callout{
    font-family:'Playfair Display', serif;
    font-weight:600;
    font-style:italic;
    color:var(--forest-deep);
    font-size:1.15rem;
    text-align:center;
    margin-top:32px;
  }

  /* ABOUT */
  .about{background:var(--cream-2);}
  .about .wrap{max-width:600px;}
  .about h3{
    font-size:1.3rem;
    margin-bottom:16px;
  }
  .about p{color:#4a493f;margin-bottom:14px;}

  /* FINAL CTA */
  .final{text-align:center;}
  .final h2{font-size:clamp(2rem,5vw,2.8rem);}
  .final blockquote{
    max-width:460px;
    margin:24px auto;
    color:#4a493f;
    font-size:1.02rem;
  }
  .final .strong-line{
    font-weight:500;
    color:var(--ink);
    margin:20px auto 30px;
    max-width:440px;
  }
  .final .price-tag{display:flex;justify-content:center;}

  footer{
    padding:36px 0;
    text-align:center;
    font-size:0.85rem;
    color:#8a8776;
  }

  @media (max-width:640px){
    section{padding:64px 0;}
    .hero{padding:80px 0 64px;}
    .topic-grid{grid-template-columns:1fr;}
    .flow-steps{grid-template-columns:1fr;gap:22px;}
  }
</style>
</head>
<body>

<section class="hero">
  <div class="wrap">
    <span class="eyebrow">Hidden Room Studios</span>
    <h1>Studio Skills</h1>
    <p class="sub">Make better recordings. Understand why they sound better.</p>
    <p class="desc">One-on-one recording, mixing, and production instruction with Patrick Hume at Hidden Room Studios.</p>
    <p class="bold-line">Bring your own project. We'll work on the actual music you're making.</p>

    <div class="img-slot hero-img"><!-- IMAGE: hero-studio.jpg — wide shot of the studio/console, ~1280x680px -->Hero image: studio/console shot</div>

    <div class="price-tag">90 minutes — <span class="amount">$90</span></div>
    <div><a href="#book" class="btn">Book a Studio Skills Session</a></div>
  </div>
</section>

<section class="problem">
  <div class="wrap">
    <h2>You don't need another YouTube tutorial.</h2>
    <p>You've probably already watched plenty of them.</p>
    <p>The hard part isn't learning what a compressor does. It's knowing <strong>when to use one, why you're using it, and what you're actually hearing.</strong></p>
    <p>That's where working one-on-one with an experienced engineer can make a difference.</p>
    <p>Bring me the song you're working on, and we'll figure it out together.</p>
  </div>
</section>

<section class="topics">
  <div class="wrap">
    <h2>What we can work on</h2>
    <ul class="topic-grid">
      <li>Recording techniques</li>
      <li>Microphone selection and placement</li>
      <li>Gain staging</li>
      <li>Signal flow</li>
      <li>EQ</li>
      <li>Compression</li>
      <li>Reverb and effects</li>
      <li>Editing</li>
      <li>Mixing</li>
      <li>Automation</li>
      <li>Critical listening</li>
      <li>Getting better results from your home studio</li>
    </ul>
    <div class="note-box">
      We won't necessarily cover all of these. Your session is built around <em>your</em> project and <em>your</em> questions.
    </div>
  </div>
</section>

<section class="flow">
  <div class="wrap">
    <h2>What happens during the session</h2>
    <div class="flow-steps">
      <div class="flow-step"><span class="num">i</span><span class="label">Bring a project.</span></div>
      <div class="flow-step"><span class="num">ii</span><span class="label">Listen.</span></div>
      <div class="flow-step"><span class="num">iii</span><span class="label">Diagnose.</span></div>
      <div class="flow-step"><span class="num">iv</span><span class="label">Work.</span></div>
      <div class="flow-step"><span class="num">v</span><span class="label">Learn.</span></div>
      <div class="flow-step"><span class="num">vi</span><span class="label">Leave with a plan.</span></div>
    </div>
  </div>
</section>

<section class="who">
  <div class="wrap">
    <h2>Who it's for</h2>
    <blockquote>Studio Skills is for musicians and producers who already know their way around a DAW but want to get better at making records.</blockquote>
    <blockquote>It's a good fit if you're recording your own music, producing a band, building a home studio, learning to mix, or simply frustrated that your recordings don't sound the way you hear them in your head.</blockquote>
    <p class="callout">You don't need to be an expert. You don't even need to know exactly what's wrong. That's part of what we'll figure out.</p>
  </div>
</section>

<section class="about">
  <div class="wrap">
    <span class="eyebrow">About Patrick</span>
    <h3>Patrick Hume</h3>
    <div class="img-slot about-photo"><!-- IMAGE: patrick-headshot.jpg — square headshot, ~400x400px --></div>
    <p>I've been teaching guitar and music for more than 23 years and have spent my career working as a musician, composer, recording engineer, and producer. I operate Hidden Room Studios, where I record, mix, and produce music for artists.</p>
    <p>Studio Skills combines that real-world experience with the thing I enjoy most about teaching: helping someone understand <em>why</em> something works.</p>
    <div class="about-clear"></div>
  </div>
</section>

<section class="final" id="book">
  <div class="wrap">
    <h2>Bring me your song.</h2>
    <blockquote>Don't bring me a list of things you think you need to learn.</blockquote>
    <p class="strong-line">Bring me the recording you're stuck on.</p>
    <blockquote>We'll listen. We'll figure out what's happening. We'll fix what we can. And you'll leave knowing more about how to do it yourself next time.</blockquote>
    <div class="price-tag">Studio Skills — 90 minutes / <span class="amount">$90</span></div>

    <div class="cta-row">
      <a href="https://calendar.app.google/NoA3qYySQ4Ve9YUG7" class="btn" target="_blank" rel="noopener">Book a Call</a>
      <a href="#inquire" class="btn btn-ghost">Send an Inquiry Instead</a>
    </div>

    <div class="divider-or" id="inquire">or tell me about your project first</div>

    <!-- FORM -->
    <form
      class="inquiry-form"
      action="https://formspree.io/f/mgodlrry"
      method="POST"
    >
      <input type="hidden" name="_subject" value="Studio Skills inquiry" />
      <div class="form-row">
        <input type="text"  name="name"  placeholder="Full name"     required />
        <input type="email" name="email" placeholder="Email address" required />
      </div>
      <div class="form-row">
        <input type="tel" name="phone" placeholder="Phone (optional)" />
        <select name="interest" required>
          <option value="" disabled selected>Area of interest</option>
          <option value="guitar">Guitar</option>
          <option value="songwriting">Songwriting</option>
          <option value="home-recording">Home Recording</option>
          <option value="production">Music Production</option>
          <option value="jazz">Jazz Guitar / Performance Inquiry</option>
          <option value="composition">Composition Commission</option>
          <option value="other">Other / Not Sure Yet</option>
        </select>
      </div>
      <textarea name="message" placeholder="Tell me a bit about where you are and what you'd like to work on."></textarea>
      <p class="form-note">You'll receive a response within 1–2 business days.</p>
      <button type="submit" class="btn-submit">Get Started</button>
    </form>
  </div>
</section>

<footer>
  <div class="wrap">Hidden Room Studios &middot; Louisville, KY</div>
</footer>

</body>
</html>
